# ==============================================================================
# CivicPulse AI - Shared Environment Variables Template
# Copy this file to '.env' and adjust values for local development.
# ==============================================================================

# Core API server configurations
PORT=5000

# Database configurations (PostgreSQL + PostGIS)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=civicpulse

# Authentication
# Set to at least 32 bytes of cryptographically random data before starting the API.
JWT_SECRET=

# Internal Microservices (AI / ML Worker)
AI_SERVICE_URL=http://localhost:5001
# Optional; match the AI service's API_KEY when key authentication is enabled.
AI_SERVICE_API_KEY=
